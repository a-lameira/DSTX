#: src/widgets/tips-dialog.vala:314
msgid "Oscillate your base color — speed adjustable."
msgstr ""

#: src/widgets/tips-dialog.vala:315
msgid ""
"Rainbow cycles through the spectrum. Wave alternates between cyan, yellow, "
"and magenta — no base color used."
msgstr ""

#: src/widgets/tips-dialog.vala:316
msgid "LED shows battery level: green = full, yellow = medium, red = low."
msgstr ""

#: src/widgets/tips-dialog.vala:317
