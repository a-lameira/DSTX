#: src/widgets/tips-dialog.vala:309 src/managers/settings-ui-builder.vala:118
msgid "Battery"
msgstr ""

#: src/widgets/tips-dialog.vala:314
msgid "Oscillating effects of the base colour with speed adjustment."
msgstr ""

#: src/widgets/tips-dialog.vala:315
msgid ""
"These effects do not use the base colour. Rainbow goes through the entire "
"colour spectrum, and Wave alternates between cyan, yellow and magenta tones."
msgstr ""

#: src/widgets/tips-dialog.vala:316
msgid ""
"The LED shows the battery level: green for charged, yellow for medium, red "
"for low."
msgstr ""

#: src/widgets/tips-dialog.vala:317
