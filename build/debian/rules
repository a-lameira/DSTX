#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CFLAGS_MAINT_APPEND = -Wall -Wextra

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- --prefix=/usr

override_dh_auto_build:
	dh_auto_build

override_dh_auto_install:
	dh_auto_install --destdir=$(CURDIR)/debian/dstx
	# Copy static binaries (already placed in src/bin/ by the build script)
	install -Dm755 $(CURDIR)/src/bin/dstx $(CURDIR)/debian/dstx/usr/bin/dstx
	install -Dm755 $(CURDIR)/src/bin/dstx-dbus $(CURDIR)/debian/dstx/usr/bin/dstx-dbus
