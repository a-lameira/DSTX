#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	# No configuration needed for pre-built binaries
	dh_auto_configure

override_dh_auto_build:
	# Nothing to build (binaries are provided externally)
	dh_auto_build

override_dh_auto_install:
	# Create directory structure
	mkdir -p $(CURDIR)/debian/dstx-core/usr/bin
	mkdir -p $(CURDIR)/debian/dstx-core/lib/systemd/system
	mkdir -p $(CURDIR)/debian/dstx-core/lib/udev/rules.d
	mkdir -p $(CURDIR)/debian/dstx-core/usr/share/polkit-1/rules.d
	mkdir -p $(CURDIR)/debian/dstx-core/etc/sudoers.d
	mkdir -p $(CURDIR)/debian/dstx-core/usr/share/dbus-1/system.d

	# Install static binaries
	install -Dm755 $(CURDIR)/build/core-static/dstx      $(CURDIR)/debian/dstx-core/usr/bin/dstx
	install -Dm755 $(CURDIR)/build/core-static/dstx-dbus $(CURDIR)/debian/dstx-core/usr/bin/dstx-dbus

	# Fix systemd unit paths: replace /usr/local/bin with /usr/bin
	sed 's|/usr/local/bin/|/usr/bin/|g' $(CURDIR)/dstx/data/dstx-daemon.service > $(CURDIR)/debian/dstx-core/lib/systemd/system/dstx-daemon.service
	sed 's|/usr/local/bin/|/usr/bin/|g' $(CURDIR)/dstx/data/dstx-dbus.service   > $(CURDIR)/debian/dstx-core/lib/systemd/system/dstx-dbus.service

	# Install udev rules (no path change needed)
	install -Dm644 $(CURDIR)/dstx/data/99-dstx.rules $(CURDIR)/debian/dstx-core/lib/udev/rules.d/99-dstx.rules

	# Install D-Bus policy (no path change)
	install -Dm644 $(CURDIR)/dstx/data/org.dstx.Bridge.conf $(CURDIR)/debian/dstx-core/usr/share/dbus-1/system.d/org.dstx.Bridge.conf

	# Install Polkit rule
	install -Dm644 $(CURDIR)/dstx/data/10-dstx.rules $(CURDIR)/debian/dstx-core/usr/share/polkit-1/rules.d/10-dstx.rules

	# Install sudoers file (will be fixed to 440 later)
	install -Dm644 $(CURDIR)/dstx/data/dstx-sudoers $(CURDIR)/debian/dstx-core/etc/sudoers.d/dstx

override_dh_fixperms:
	dh_fixperms
	# Ensure sudoers file has correct permissions (440)
	chmod 440 $(CURDIR)/debian/dstx-core/etc/sudoers.d/dstx

override_dh_auto_clean:
	dh_auto_clean
	rm -rf $(CURDIR)/debian/dstx-core
